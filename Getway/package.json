    "remove:dev": "serverless remove --stage develop --aws-profile serverless_user_personal"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/jsonwebtoken": "^9.0.10",
    "aws-lambda": "^1.0.7",
    "serverless": "^4.44.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3"
  }
}